{
  "manifest_version": 3,
  "name": "MasLingo",
  "version": "1.1.8",
  "description": "网页、漫画与视频翻译：双语阅读、划词词典和独立阅读侧栏。",
  "icons": {
    "16": "assets/maslingo-16.png",
    "32": "assets/maslingo-32.png",
    "48": "assets/maslingo-48.png",
    "128": "assets/maslingo-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:11434/*",
    "https://translate.googleapis.com/*",
    "https://cn.bing.com/*",
    "https://www.bing.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://translation.googleapis.com/*",
    "https://fanyi-api.baidu.com/*",
    "https://openapi.youdao.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.moonshot.cn/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.siliconflow.cn/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.x.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "assets/maslingo-16.png",
      "24": "assets/maslingo-24.png",
      "32": "assets/maslingo-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "translation/providers.js",
        "content/reader-bridge.js",
        "content/quick-toolbar.js",
        "content/overlay.js",
        "content/auto.js",
        "content/panel.js",
        "content/content.js",
        "content/text-translate.js",
        "content/selection-translate.js",
        "content/video-translate.js"
      ],
      "css": [
        "content/styles/marker.css",
        "content/styles/page.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options/options.html",
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "reader/reader.html"
  }
}

{
  "manifest_version": 3,
  "name": "OpenMangaTranslator",
  "version": "1.0.2",
  "description": "日文漫画 OCR 翻译：识别画面文字并把译文嵌回原图。默认使用官方托管后端，无需本机环境。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*",
    "https://*.sslip.io/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}

# Copy to deploy/.env and edit. Everything except OMT_DOMAIN has a safe default.

# Public hostname that resolves to this VM's public IP.
# No domain? Use sslip.io, which maps <ip>.sslip.io to <ip>:
#   public IP 130.61.10.20  ->  OMT_DOMAIN=130.61.10.20.sslip.io
OMT_DOMAIN=CHANGE_ME.sslip.io

# OCR worker tuning. A 4-core Always Free ARM instance works well with:
OMT_TORCH_THREADS=3
OMT_OCR_CONCURRENCY=2

# Per-IP rate limit for the public instance (0 disables the limiter).
OMT_RATE_LIMIT_REQUESTS=40
OMT_RATE_LIMIT_WINDOW=60

# Browser origins allowed to call this API. Extensions with matching host
# permissions bypass CORS, so "*" is only needed for testing from a web page.
OMT_ALLOWED_ORIGINS=*

# Google's free translate endpoint is shared per server IP; heavy use gets the
# VM throttled or blocked. Set to 0 to force users onto their own API key.
OMT_ENABLE_FREE_TRANSLATE=1

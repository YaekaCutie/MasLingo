.venv/
backend/.env
__pycache__/
*.pyc

# Extension signing keys and built packages must never be committed.
*.pem
*.crx
*.zip

# Local deployment secrets (domain, tuning) — see deploy/.env.example
deploy/.env

# Local OCR model cache when running the backend outside Docker
.hf/

# On-device OCR assets: fetched by tools/fetch_ocr_assets.py, never committed
# (the wasm runtime is ~14 MB and the int8 model is ~111 MB).
extension/vendor/
extension/models/

# Node tooling
node_modules/
package-lock.json

# 用户提供的原图样本，不入库
Image from URL*
